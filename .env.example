# JobPilot works with its built-in loopback defaults and does not require a .env file.
# Vite reads this optional file for VITE_* overrides. The API launcher reads process environment
# variables directly and does not load .env. Never commit .env.

# Web and Extension build-time API origin. Runtime clients reject non-loopback hosts.
VITE_API_BASE_URL=http://127.0.0.1:8000

# The Extension uses manifest host_permissions for its direct loopback request. Its fixed default
# works without configuration; do not add the Extension ID to API CORS.
