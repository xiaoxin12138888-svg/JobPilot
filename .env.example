# Copy this file to .env for local development. Never commit .env.

# Web and Extension build-time API origin. Runtime clients reject non-loopback hosts.
VITE_API_BASE_URL=http://127.0.0.1:8000

# FastAPI only accepts an IP-literal loopback bind address.
JOBPILOT_API_BIND_HOST=127.0.0.1

# Comma-separated exact origins. Never use wildcard or credentials.
# To test the Extension, append its exact chrome-extension://<32-character-id> origin.
JOBPILOT_CORS_ORIGINS=http://127.0.0.1:5173
