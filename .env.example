# Copy this file to .env. Vite reads it for Web and Extension builds.
# This value is public client configuration, not a secret.
VITE_API_BASE_URL=http://localhost:8000

# Public Extension OAuth configuration. The .invalid values are deterministic
# examples only; they are not a real Auth0 tenant or successful integration.
VITE_AUTH_ISSUER=https://tenant.example.invalid/
VITE_AUTH_AUTHORIZE_URL=https://tenant.example.invalid/authorize
VITE_AUTH_TOKEN_URL=https://tenant.example.invalid/oauth/token
VITE_AUTH_JWKS_URL=https://tenant.example.invalid/.well-known/jwks.json
VITE_AUTH_AUDIENCE=https://api.jobpilot.example.invalid
VITE_AUTH_EXTENSION_CLIENT_ID=replace-with-public-extension-client-id
VITE_AUTH_REVOKE_URL=https://tenant.example.invalid/oauth/revoke
VITE_WEB_APP_URL=http://localhost:5173

# FastAPI does not load this file automatically. These values document the API process
# environment; inject them into the process when overriding the safe development defaults.
JOBPILOT_ENVIRONMENT=development
JOBPILOT_CORS_ORIGINS=http://localhost:5173

# PostgreSQL is the Phase 2B persistence source. Use local-only development
# credentials here; inject real deployment credentials outside Git.
JOBPILOT_DATABASE_URL=postgresql+psycopg://jobpilot:jobpilot_dev@localhost:5432/jobpilot

# Server-side OIDC configuration. These deterministic .invalid placeholders
# make the required shape explicit but cannot authenticate a real user.
JOBPILOT_AUTH_ISSUER=https://tenant.example.invalid/
JOBPILOT_AUTH_JWKS_URL=https://tenant.example.invalid/.well-known/jwks.json
JOBPILOT_AUTH_JWKS_CACHE_SECONDS=300
JOBPILOT_AUTH_JWKS_TIMEOUT_SECONDS=5
JOBPILOT_AUTH_AUTHORIZE_URL=https://tenant.example.invalid/authorize
JOBPILOT_AUTH_TOKEN_URL=https://tenant.example.invalid/oauth/token
JOBPILOT_AUTH_AUDIENCE=https://api.jobpilot.example.invalid
JOBPILOT_AUTH_WEB_CLIENT_ID=replace-with-web-client-id
# Required only for a live confidential Web client. Never expose it with a VITE_ prefix.
JOBPILOT_AUTH_WEB_CLIENT_SECRET=
JOBPILOT_AUTH_EXTENSION_CLIENT_ID=replace-with-public-extension-client-id
# Web ID tokens use the standard email/email_verified claims. These namespaced
# claims apply only to Extension API access tokens.
JOBPILOT_AUTH_ACCESS_TOKEN_EMAIL_CLAIM=https://jobpilot.example.invalid/claims/email
JOBPILOT_AUTH_ACCESS_TOKEN_EMAIL_VERIFIED_CLAIM=https://jobpilot.example.invalid/claims/email_verified

# Deferred Auth0 Management API capability for a future recent-authenticated revoke-all.
# Task 6 does not load these values. Leave credentials empty until a later contract and
# least-privilege M2M client are explicitly approved by the project owner.
JOBPILOT_AUTH_MANAGEMENT_BASE_URL=https://tenant.example.invalid/api/v2/
JOBPILOT_AUTH_MANAGEMENT_AUDIENCE=https://tenant.example.invalid/api/v2/
JOBPILOT_AUTH_MANAGEMENT_CLIENT_ID=
JOBPILOT_AUTH_MANAGEMENT_CLIENT_SECRET=

# Production requires exact HTTPS schemeful-same-site Web/API origins.
JOBPILOT_WEB_ORIGIN=http://localhost:5173
JOBPILOT_WEB_CALLBACK_URL=http://localhost:8000/api/v1/auth/web/callback
JOBPILOT_WEB_SESSION_IDLE_SECONDS=604800
JOBPILOT_WEB_SESSION_ABSOLUTE_SECONDS=2592000
JOBPILOT_AUTH_CLOCK_SKEW_SECONDS=60
