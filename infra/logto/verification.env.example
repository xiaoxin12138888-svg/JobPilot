# Copy to infra/logto/.env.logto-verification. That destination is ignored by Git.
# Use a URL-safe local-only password (for example, a generated hexadecimal value)
# because it is interpolated into PostgreSQL DB_URL. Never reuse a real credential.
LOGTO_DB_USER=logto_verification
LOGTO_DB_PASSWORD=
LOGTO_DB_NAME=logto_verification

# Initial service-start verification uses loopback HTTP. JobPilot Task 5-7 live
# integration still requires a trusted HTTPS issuer and must not be marked PASS
# until that separate local TLS boundary is configured and verified.
LOGTO_ENDPOINT=http://localhost:3001
LOGTO_ADMIN_ENDPOINT=http://localhost:3002
